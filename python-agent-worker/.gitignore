# Python 虚拟环境
.venv/

# 字节码与缓存
__pycache__/
*.py[cod]
*$py.class
*.pyc

# 测试与类型检查缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/

# 构建产物
dist/
build/
*.egg-info/

# 本地密钥与环境文件（只忽略文件本身，不写入任何真实值）
.env
.env.*

# 常见 IDE 产物
.idea/
.vscode/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/
.spyderproject
.spyproject
.ropeproject

# 操作系统与编辑器临时文件
.DS_Store
Thumbs.db
*~
*.swp
*.swo

# 历史测试仍忽略，仅放行已交付的 v2 结果/失败契约回归
/tests/**
!/tests/**/
!/tests/messaging/dto/test_result_failure_v2.py
!/tests/prediction/test_replay_context.py
!/tests/replay/test_export.py
!/tests/replay/test_manifest.py
!/tests/replay/test_source.py
!/tests/replay/test_bundle.py
!/tests/replay/test_isolated.py
!/tests/replay/test_workflow.py

# 放行 A 阶段厂商 Fake、公共接线和受控运行时回归，不放行缓存或秘密
!/tests/common/test_deepseek_config.py
!/tests/prediction/test_model_vendor_api.py
